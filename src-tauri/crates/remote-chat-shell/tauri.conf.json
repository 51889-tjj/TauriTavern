{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriTavern Remote",
  "version": "0.1.0",
  "identifier": "com.tauritavern.remotechat",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run web:build",
      "cwd": "../../.."
    },
    "beforeDevCommand": {
      "script": "node scripts/tauri-dev-server.mjs",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:1430",
    "frontendDist": "../../../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TauriTavern Remote",
        "width": 430,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "disableInputAccessoryView": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../tauritavern/icons/32x32.png",
      "../tauritavern/icons/128x128.png",
      "../tauritavern/icons/128x128@2x.png",
      "../tauritavern/icons/icon.icns",
      "../tauritavern/icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.ios.plist"
    }
  }
}
